# AttackGraph Environment Configuration
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# PostgreSQL
POSTGRES_USER=attackgraph
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=attackgraph
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# SQLAlchemy async database URL
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Application secret key (generate a strong random value for production)
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# Test database (used by integration tests)
TEST_DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}_test
